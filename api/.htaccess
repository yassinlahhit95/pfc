# Allow OPTIONS for CORS preflight (root .htaccess restricts to GET POST HEAD globally)
# DELETE is required by api/v1/auth.php's logout handler.
<LimitExcept GET POST DELETE OPTIONS>
    Require all denied
</LimitExcept>

# CORS headers for the v1 mobile API
# Native mobile apps don't need CORS, but a future PWA or web client will.
# Access-Control-Allow-Origin below is kept in sync with .env's APP_URL
# automatically (install wizard step 2, and vistas/admin/saas/estado.php's
# credentials form) — see updateCorsOrigin() in install/lib/helpers.php.
# It only needs a manual edit if APP_URL is ever changed by hand-editing
# .env directly instead of through one of those two paths.
<IfModule mod_headers.c>
    # CORS configuration (auto-synced with APP_URL via install wizard)
    Header always set Access-Control-Allow-Origin "https://aulapro.yassin.agency"
    Header always set Access-Control-Allow-Methods "GET, POST, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With, X-API-Key, X-Timestamp, X-Signature"
    Header always set Access-Control-Max-Age "86400"
    Header always set Access-Control-Allow-Credentials "true"

    # Security headers for API responses
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"

    # Respond immediately to OPTIONS preflight without hitting PHP
    <If "%{REQUEST_METHOD} == 'OPTIONS'">
        Header always set Content-Length "0"
        Header always set Content-Type "text/plain"
    </If>
</IfModule>

# Short cache for API JSON responses — clients should revalidate frequently
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>
