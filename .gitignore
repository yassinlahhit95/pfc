# =============================================
#  AulaPro — .gitignore
# =============================================

# Credenciales y secretos (nunca subir al repositorio)
.env
.env.local
.env.*.local
config/secrets.php
config/service-account.php
config/service-account.json
config/*.json
*.key
*.pem
*.p12

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Herramientas de entorno local
/nbproject/
/vendor/
/node_modules/
.phpunit.result.cache
.php-cs-fixer.cache
.php_cs.cache


# Archivos de sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporales de PHP y servidor
sess_*
*.log
*.tmp
error_log

# Archivos de video (demasiado grandes para Git)
public/videos/

# Archivos subidos por usuarios (se regeneran en producción)
public/uploads/pfc/*
!public/uploads/pfc/.gitkeep

