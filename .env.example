# ─────────────────────────────────────────────
# AulaPro — Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Firebase (optional — leave empty if not used)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Realtime Database URL for chat real-time updates
# Format: https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=
# Web Push VAPID key — Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
FIREBASE_VAPID_KEY=

# Brevo API (transactional email)
BREVO_API_KEY=your_brevo_key

# Boletín QR Secret — generate once with: php -r "echo bin2hex(random_bytes(32));"
# Use the SAME secret on local and server or QR codes won't verify across environments
BOLETIN_SECRET=your_boletin_secret

# Personal-data encryption key (RGPD Art. 32) — generate once with:
# php -r "echo bin2hex(random_bytes(32));"
# Use the SAME value on every environment. If it is ever lost or changed,
# every already-encrypted value (DNI, address, phone, MFA secrets, etc.)
# becomes permanently unreadable.
PII_ENCRYPTION_KEY=your_pii_encryption_key

# Cloudflare R2 (file storage — S3-compatible, free tier)
# New uploads (TFG documents, classroom resources, expense receipts, challenge
# submissions, landing/blog images) are stored here instead of public/uploads/.
# Files already in public/uploads/ are NOT migrated and keep being served from
# local disk indefinitely — leaving these empty does not break the app, it
# just means uploads keep going to local disk as before.
#
# R2_ACCOUNT_ID: Cloudflare Dashboard → right sidebar of any page ("Account ID"),
#   or R2 → Overview.
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → "Manage API Tokens" → "Create
#   API Token". Use a token scoped to "Object Read & Write" on this ONE bucket
#   only — never a global Cloudflare account token — so a leaked credential
#   can't affect anything beyond this bucket. The secret is shown once only;
#   if lost, revoke the token and create a new one.
# R2_BUCKET_NAME: exact bucket name from R2 → Overview.
# R2_PUBLIC_URL: only needed if you enable Public Access on the bucket (R2 →
#   bucket → Settings → Public Access) for serving landing/blog images — the
#   resulting base URL (the free <bucket>.r2.dev subdomain, or a connected
#   custom domain). No trailing slash. Leave empty if not using public images yet.
#
# Free tier limits (stays at 0€/month while under these): 10 GB storage,
# 1,000,000 Class A operations/month (uploads/deletes/lists), 10,000,000
# Class B operations/month (downloads/reads). Egress (outbound traffic) is
# always free, with no limit, even beyond the free tier.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# R2_TENANT_PREFIX: only needed if multiple clients share ONE R2 bucket (a
# SaaS operator running several white-label instances against a single
# Cloudflare account). Auto-generated and written here the first time this
# instance pairs with SaaS-Admin (vistas/admin/saas/estado.php) — leave empty
# and let that happen automatically. Only set by hand for a manual (no
# pairing) setup, and always to something globally unique across every
# client sharing that bucket — config/Config.php otherwise derives it from
# the subdomain, which collapses to the same 'default' value for every
# client on a bare custom domain (2 DNS labels), silently merging their
# storage usage/quota tracking together.
R2_TENANT_PREFIX=

# SaaS Admin integration — ADMIN_API_KEY/ADMIN_API_SECRET is the same connection
# secret admin.php already authenticates inbound calls with (only one shared
# keypair per connection, used in both directions) and signs LicenseToken.php's
# tokens. SAAS_ADMIN_URL and ADMIN_API_KEY/ADMIN_API_SECRET are normally filled in
# automatically by pairing (AulaPro → Estado de la Plataforma → "Emparejar con
# SaaS-Admin") — only set these by hand if pairing isn't available.
SAAS_ADMIN_URL=
ADMIN_API_KEY=
ADMIN_API_SECRET=

# Application
# Canonical public URL — used to build email links safely (prevents Host-header
# injection in password-reset links). No trailing slash.
APP_URL=https://aulapro.yassin.agency
APP_ENV=production
APP_DEBUG=false
SESSION_TIMEOUT=3600

# Google Authentication Client ID (Web Client ID)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Cron shared secret — authenticates GET requests to
# controladores/comunes/recordatorios/procesar.php?token=... (no session/guard,
# called by an external scheduler). Generate once with:
# php -r "echo bin2hex(random_bytes(32));"
CRON_TOKEN=your_cron_token
