# ─────────────────────────────────────────────
# AulaPro — Environment Configuration
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# Database
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# Firebase (optional — leave empty if not used)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Brevo API (transactional email)
BREVO_API_KEY=your_brevo_key

# Boletín QR Secret — generate once with: php -r "echo bin2hex(random_bytes(32));"
# Use the SAME secret on local and server or QR codes won't verify across environments
BOLETIN_SECRET=your_boletin_secret

# Application
APP_ENV=production
APP_DEBUG=false
SESSION_TIMEOUT=3600
