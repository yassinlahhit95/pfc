# Direct HTTP access to reto/challenge files is DENIED.
# Files are served exclusively through controladores/comunes/descargar_zip_reto.php
# which enforces session auth + authorization checks.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
