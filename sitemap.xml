  <?php
  // Artículos publicados del Blog
  try {
      $con = obtenerConexion();
      $res = mysqli_query($con, "SELECT slug, updated_at, created_at FROM blog_posts WHERE publicado = 1 ORDER BY id DESC LIMIT 100");
      if ($res) {
          while ($post = mysqli_fetch_assoc($res)) {
              $postDate = !empty($post['updated_at']) ? date('Y-m-d', strtotime($post['updated_at'])) : date('Y-m-d', strtotime($post['created_at']));
              $postSlug = urlencode($post['slug']);
              echo "  <url>\n";
              echo "    <loc>" . $base . "/vistas/blog.php?slug=" . $postSlug . "</loc>\n";
              echo "    <lastmod>" . $postDate . "</lastmod>\n";
              echo "    <changefreq>monthly</changefreq>\n";
              echo "    <priority>0.7</priority>\n";
              echo "  </url>\n";
          }
      }
  } catch (Throwable $e) {}
