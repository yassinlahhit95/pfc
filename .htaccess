<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml

    # Remove browser bugs
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # Video
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/mpeg "access plus 1 year"
    # CSS, JavaScript — safe at 1 year since every core/feature CSS/JS link is
    # cache-busted with a ?v=filemtime query string (footer.php, nav.php, AssetMin.php)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    # Others
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Disable directory listing
Options -Indexes

# sitemap.xml and robots.txt are PHP scripts (per-tenant: they derive the site's
# own domain from HTTP_HOST / configuracion_centro rather than hardcoding one
# client's URL) but keep their conventional static filenames — crawlers only
# ever check /robots.txt and /sitemap.xml, never a .php equivalent. Without
# this, Apache serves them as plain static files and a crawler gets the raw
# PHP source instead of executed output.
<IfModule mod_mime.c>
    <Files "sitemap.xml">
        ForceType application/x-httpd-php
    </Files>
    <Files "robots.txt">
        ForceType application/x-httpd-php
    </Files>
</IfModule>

# ── Force HTTPS ────────────────────────────────────────────────────────────────
# Checks X-Forwarded-Proto too so this doesn't loop behind a proxy/CDN that
# terminates TLS and forwards to the origin over plain HTTP.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # HSTS — solo se envía en respuestas HTTPS reales (env=HTTPS, puesto por
    # mod_ssl). En local (pfc.test, normalmente HTTP) esta cabecera nunca se
    # envía, así que no hay riesgo de "atascar" el navegador en HTTPS para
    # un host de desarrollo sin TLS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Prevent MIME type sniffing
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # CSP — 'unsafe-inline' is required for script-src/style-src: this app has
    # inline <script> blocks and inline event-handler attributes across ~100+
    # view files (a hand-rolled jQuery app, not a nonce/CSP-first build like
    # saas-admin). Removing unsafe-inline would need converting all of that to
    # addEventListener/data-attribute bindings first — too large and too risky
    # to do blind against a live school system in this pass. What this CSP still
    # buys: default-src 'self' blocks loading any *other* unlisted third-party
    # script/resource (the main way an XSS payload would exfiltrate data or pull
    # in additional attacker code), plus object-src/base-uri/frame-ancestors,
    # which unsafe-inline does NOT weaken.
    #
    # IMPORTANT — this is a SECOND, independent CSP definition. include/Security.php's
    # buildCsp() (sent via header() by Security::initSession(), called from every
    # role Guard) is the other one. Because Apache's "Header always set" runs as an
    # output filter *after* PHP has already sent its headers, this one silently wins
    # and replaces whatever buildCsp() sent — on every page, not just ones without a
    # Guard. The two drifted apart once already (this one was missing
    # images.unsplash.com / videos.pexels.com / the R2 public host, breaking landing
    # demo images+video and R2-hosted blog/landing images site-wide until fixed here).
    # If you add a new external host to buildCsp(), add it here too, or it will be
    # silently blocked in production regardless of what PHP sends.
    #
    # The R2 host below (pub-7950bc18f89...r2.dev) is hardcoded because this file
    # can't read .env's R2_PUBLIC_URL at request time the way buildCsp() does — if
    # that bucket's public URL ever changes (new bucket, moved account, white-label
    # deployment with its own R2), update the host in img-src below too.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://code.jquery.com https://www.gstatic.com https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https://www.gravatar.com https://*.googleusercontent.com https://images.unsplash.com https://pub-7950bc18f89d4d87970adbf3ebde7f2a.r2.dev; media-src 'self' https://videos.pexels.com; frame-src 'self' https://player.vimeo.com https://www.youtube-nocookie.com https://accounts.google.com; connect-src 'self' https://*.googleapis.com https://*.gstatic.com wss://*.firebaseio.com https://*.firebaseio.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>
