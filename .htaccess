# ══════════════════════════════════════════════════════════════════════════════
# AULAPRO - CONFIGURACIÓN DE RENDIMIENTO Y SEGURIDAD
# ══════════════════════════════════════════════════════════════════════════════

# 1. COMPRESIÓN GZIP (Reduce el tamaño de transferencia hasta un 70%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/wasm
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 2. CACHÉ DEL NAVEGADOR (Evita descargas redundantes en visitas recurrentes)
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imágenes (1 año)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fuentes (1 año)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # CSS y JS (1 mes)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Video (1 año)
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
</IfModule>

# 3. SEGURIDAD
Options -Indexes

# Bloquear acceso directo a archivos sensibles (Apache 2.4)
<IfModule mod_authz_core.c>
    <FilesMatch "(\.env(.*)|\.user\.ini|composer\.(json|lock)|database\.sql|\.htpasswd|\.gitignore)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Bloquear acceso directo a carpetas internas
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|include|modelos|templates|logs|vendor|security|cron)(/|$) - [F,L]

    # Bloquear User-Agents típicos de bots maliciosos y scanners
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|winhttp|clshttp|loader) [NC]
    RewriteRule .* - [F,L]

    # Bloquear peticiones sin User-Agent (la mayoría de bots primitivos)
    RewriteCond %{HTTP_USER_AGENT} ^-?$
    RewriteRule .* - [F,L]
</IfModule>

# Páginas de error genéricas (sin revelar 403 vs 404)
ErrorDocument 400 /vistas/error.php
ErrorDocument 403 /vistas/error.php
ErrorDocument 404 /vistas/error.php
ErrorDocument 500 /vistas/error.php

# Cabeceras de seguridad HTTP
<IfModule mod_headers.c>
    # Anti-clickjacking — DENY is stricter than SAMEORIGIN
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Desactivar APIs que la app no necesita
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Aislamiento de origen (Spectre / cross-origin leaks)
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    # Ocultar versión de servidor
    Header always unset X-Powered-By
    Header always unset Server

    # HSTS: activo bajo HTTPS nativo o cuando Cloudflare indica HTTPS (Flexible SSL mode)
    # X-Forwarded-Proto is safe to trust here because Cloudflare always overwrites it.
    <If "%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'">
        Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    </If>

    # Protección XSS legacy (IE/Edge antiguos)
    Header always set X-XSS-Protection "1; mode=block"

    # Bloquear acceso cross-domain (Flash, PDF, Silverlight)
    Header always set X-Permitted-Cross-Domain-Policies "none"

    # CSP — permite self + recursos externos que usa la app (Firebase, Google Fonts, jQuery CDN)
    #
    # KNOWN LIMITATION — unsafe-inline in script-src and style-src:
    #   'unsafe-inline' voids XSS protection. It is kept here because many PHP views emit
    #   inline <script> and <style> blocks with server-side data.
    #
    # MIGRATION PATH — replace unsafe-inline with per-request nonces:
    #   1. Security::initSession() generates a nonce: bin2hex(random_bytes(16))
    #      and stores it in a static Security::$cspNonce property.
    #   2. nav.php emits the CSP header via header() with 'nonce-{value}' instead of
    #      'unsafe-inline', then removes this .htaccess CSP with Header always unset.
    #   3. Every <script> and <style> tag in every view gets nonce="<?= Security::$cspNonce ?>".
    #   Until that refactor is complete, the inline directives remain.
    Header always set Content-Security-Policy "\
default-src 'self'; \
base-uri 'self'; \
object-src 'none'; \
frame-ancestors 'none'; \
img-src 'self' data: https://aulapro.yassin.agency https://pfc.test https://lh3.googleusercontent.com https://firebasestorage.googleapis.com; \
font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; \
style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; \
script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdnjs.cloudflare.com https://code.jquery.com https://cdn.jsdelivr.net; \
worker-src 'self' blob:; \
connect-src 'self' https://fcmregistrations.googleapis.com https://firebase.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.gstatic.com https://api.brevo.com; \
form-action 'self'; \
upgrade-insecure-requests"
</IfModule>

# 4. PROTECCIÓN CONTRA BOTS / DDoS (nivel Apache)
# 21 MB — covers the 20 MB TFG upload limit + form fields overhead.
# A smaller value here silently blocks large uploads with Apache 413 before PHP runs.
LimitRequestBody 22020096

# Limitar métodos HTTP a los necesarios
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>

# Rate limiting con mod_evasive (si está instalado en producción)
# En producción instalar: sudo apt install libapache2-mod-evasive
<IfModule mod_evasive24.c>
    DOSHashTableSize    3097
    DOSPageCount        10
    DOSSiteCount        50
    DOSPageInterval     1
    DOSSiteInterval     1
    DOSBlockingPeriod   600
</IfModule>
